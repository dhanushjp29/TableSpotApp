# Production must keep all Razorpay mock modes disabled.
NODE_ENV=production
PORT=5000
CLIENT_URL=https://app.example.com
CLIENT_ORIGINS=
COOKIE_DOMAIN=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
ACCESS_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_random_secret_at_least_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=no-reply@example.com
# Razorpay key mode. "test" allows rzp_test_ keys, "live" requires rzp_live_ keys.
# Omitted in production defaults to "live". Mocks stay disabled in both modes.
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
SALT_ROUNDS=12
MAX_FILE_SIZE_BYTES=5242880
MAX_UPLOAD_FILES=20
WARNING_JOB_INTERVAL_MS=3600000
TABLE_STATUS_JOB_INTERVAL_MS=30000
DEADLINE_JOB_INTERVAL_MS=3600000
OFFER_JOB_INTERVAL_MS=3600000
RAZORPAY_ORDER_MOCK=false
RAZORPAY_REFUND_MOCK=false
RAZORPAY_ONBOARDING_MOCK=false
